{
  "name": "gitis",
  "version": "0.0.0",
  "description": "A git-backed and YAML-based distributed issue tracker.",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "bin": {
    "gitis": "build/cli.js"
  },
  "files": [
    "build"
  ],
  "directories": {
    "test": "tests",
    "lib": "source",
    "issues": "issues"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test build-tests/tests/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adius/gitis.git"
  },
  "keywords": [
    "issue",
    "bug",
    "tracker"
  ],
  "author": "Adrian Sieber",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/adius/gitis/issues"
  },
  "homepage": "https://github.com/adius/gitis#readme",
  "dependencies": {
    "js-yaml": "^4.1.0",
    "nconf": "^0.12.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/nconf": "^0.10.7",
    "@types/node": "^20.11.0",
    "@types/yargs": "^17.0.32",
    "typescript": "^5.4.0"
  }
}
